# Staging environment
APP_NAME=ai-routing-layer-staging
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://user:pass@staging-db.example.com/routing_staging

# Redis Staging
REDIS_URL=redis://staging-cache.example.com:6379/0

# Real API keys (from secrets manager)
OPENAI_API_KEY=${OPENAI_API_KEY_STAGING}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY_STAGING}

ROUTING_CONFIG_PATH=/app/config/routing.yaml
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY_STAGING}
