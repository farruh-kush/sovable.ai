# ─────────────────────────────────────────────────────────────────────────────
# Kubernetes Secrets Template
#
# DO NOT commit actual secrets to git. Use this template to generate
# secrets and apply them manually, or use a secrets manager (e.g.
# AWS Secrets Manager, HashiCorp Vault, Sealed Secrets).
#
# Apply with:
#   kubectl apply -f secrets.yaml -n ai-routing
#
# Author: Farruh
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: provider-secrets
  namespace: ai-routing
type: Opaque
stringData:
  openai-api-key: "REPLACE_WITH_OPENAI_KEY"
  anthropic-api-key: "REPLACE_WITH_ANTHROPIC_KEY"
  google-api-key: "REPLACE_WITH_GOOGLE_KEY"
  mistral-api-key: "REPLACE_WITH_MISTRAL_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: ai-routing
type: Opaque
stringData:
  auth-url: "postgresql+asyncpg://postgres:REPLACE_PASSWORD@postgres:5432/auth_db"
  billing-url: "postgresql+asyncpg://postgres:REPLACE_PASSWORD@postgres:5432/billing_db"
---
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: ai-routing
type: Opaque
stringData:
  url: "redis://redis:6379/0"
  url-db1: "redis://redis:6379/1"
  url-db2: "redis://redis:6379/2"
---
apiVersion: v1
kind: Secret
metadata:
  name: gateway-secret
  namespace: ai-routing
type: Opaque
stringData:
  admin-api-key: "REPLACE_WITH_ADMIN_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: auth-secret
  namespace: ai-routing
type: Opaque
stringData:
  secret-key: "REPLACE_WITH_SECRET_KEY"
