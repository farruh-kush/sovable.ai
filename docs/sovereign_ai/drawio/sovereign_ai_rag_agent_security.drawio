&lt;br&gt;ACL/classification metadata&lt;br&gt;encryption + retention" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="610" width="320" height="100" as="geometry" /></mxCell><mxCell id="ra_retrieve" value="&lt;b&gt;Authorized retrieval&lt;/b&gt;&lt;br&gt;filter before prompt assembly&lt;br&gt;log source IDs and policy result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="610" width="220" height="100" as="geometry" /></mxCell><mxCell id="ra_context" value="&lt;b&gt;Minimal context&lt;/b&gt;&lt;br&gt;only permitted chunks enter model context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1f3d;strokeColor=#c9992e;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="800" width="300" height="75" as="geometry" /></mxCell><mxCell id="ra_intent" value="&lt;b&gt;User intent&lt;/b&gt;&lt;br&gt;request + tenant + purpose + risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1f3d;strokeColor=#c9992e;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="210" width="210" height="80" as="geometry" /></mxCell><mxCell id="ra_plan" value="&lt;b&gt;Plan generator&lt;/b&gt;&lt;br&gt;model proposes steps&lt;br&gt;not an authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="210" height="85" as="geometry" /></mxCell><mxCell id="ra_policy" value="&lt;b&gt;Plan policy check&lt;/b&gt;&lt;br&gt;allowed tools · data scope&lt;br&gt;max steps · budget · approvals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1480" y="210" width="180" height="105" as="geometry" /></mxCell><mxCell id="ra_registry" value="&lt;b&gt;Tool registry&lt;/b&gt;&lt;br&gt;schema · read/write scope&lt;br&gt;network allowlist · risk level" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d9f3e8;strokeColor=#127a51;fontColor=#1d2733;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="430" width="230" height="105" as="geometry" /></mxCell><mxCell id="ra_cap" value="&lt;b&gt;Capability broker&lt;/b&gt;&lt;br&gt;short-lived tool token&lt;br&gt;tenant + resource scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="430" width="220" height="105" as="geometry" /></mxCell><mxCell id="ra_hitl" value="&lt;b&gt;Human approval&lt;/b&gt;&lt;br&gt;payment · publish · delete&lt;br&gt;record change · external send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b44343;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="430" width="180" height="105" as="geometry" /></mxCell><mxCell id="ra_sandbox" value="&lt;b&gt;Sandbox / microVM&lt;/b&gt;&lt;br&gt;filesystem + network limits&lt;br&gt;secrets denied by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1080" y="650" width="250" height="100" as="geometry" /></mxCell><mxCell id="ra_action" value="&lt;b&gt;Enterp