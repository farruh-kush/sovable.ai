<mxfile host="app.diagrams.net" modified="2026-08-11T16:04:50Z" agent="Farruh" version="24.7.17" type="device"><diagram id="rag-and-agent-security-blueprint" name="RAG and Agent Security Blueprint"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ra_title" value="&lt;b&gt;RAG and agentic AI security blueprint&lt;/b&gt;&lt;br&gt;authorization must happen before context assembly and again before tool execution" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#0e1f3d;fontSize=16;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="60" as="geometry" /></mxCell><mxCell id="ra_rag_zone" value="&lt;b&gt;RAG plane&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#2f5fb0;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="790" height="820" as="geometry" /></mxCell><mxCell id="ra_agent_zone" value="&lt;b&gt;Agent plane&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fbf7;strokeColor=#127a51;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="790" height="820" as="geometry" /></mxCell><mxCell id="ra_shared_zone" value="&lt;b&gt;Shared trust controls&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f2ff;strokeColor=#7a4fa3;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1660" height="85" as="geometry" /></mxCell><mxCell id="ra_files" value="&lt;b&gt;Documents / data sources&lt;/b&gt;&lt;br&gt;file