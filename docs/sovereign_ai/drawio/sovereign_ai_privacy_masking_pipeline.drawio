<mxfile host="app.diagrams.net" modified="2026-08-11T16:04:50Z" agent="Farruh" version="24.7.17" type="device"><diagram id="pii-masking-and-re-identification-pipeline" name="PII Masking and Re-identification Pipeline"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m_title" value="&lt;b&gt;Privacy fabric: detect → classify → transform → route → validate → restore&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#0e1f3d;fontSize=16;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1050" height="50" as="geometry" /></mxCell><mxCell id="m_ingest_zone" value="&lt;b&gt;1. Ingest and detect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8ff;strokeColor=#2f5fb0;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="490" height="700" as="geometry" /></mxCell><mxCell id="m_policy_zone" value="&lt;b&gt;2. Decide and transform&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fbf7;strokeColor=#127a51;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="490" height="700" as="geometry" /></mxCell><mxCell id="m_model_zone" value="&lt;b&gt;3. Provider/model boundary&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#c9992e;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="490" height="700" as="geometry" /></mxCell><mxCell id="m_restore_zone" value="&lt;b&gt;4. Validate and return&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f2ff;strokeColor=#7a4fa3;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=15;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="1550" height="110" as="geometry" /></mxCell><mxCell id="m_request" value="&lt;b&gt;Raw request&lt;/b&gt;&lt;br&gt;text · files · image · tool args" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1f3d;strokeColor=#c9992e;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="190" height="75" as="geometry" /></mxCell><mxCell id="m_parse" value="&lt;b&gt;Parse + normalize&lt;/b&gt;&lt;br&gt;canonical schema · file type · size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="170" height="75" as="geometry" /></mxCell><mxCell id="m_detect" value="&lt;b&gt;Detection ensemble&lt;/b&gt;&lt;br&gt;regex/checksum · NER · context&lt;br&gt;secret scan · OCR · classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="340" width="320" height="95" as="geometry" /></mxCell><mxCell id="m_entities" value="&lt;b&gt;Entity inventory&lt;/b&gt;&lt;br&gt;type · span · confidence · source&lt;br&gt;PII · health · bank · IP · secret" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d9f3e8;strokeColor=#127a51;fontColor=#1d2733;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="500" width="320" height="95" as="geometry" /></mxCell><mxCell id="m_classify" value="&lt;b&gt;Data-classification policy&lt;/b&gt;&lt;br&gt;Tier 1 restricted · Tier 2 internal&lt;br&gt;Tier 3 public · uncertainty handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1f3d;strokeColor=#c9992e;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="180" width="360" height="95" as="geometry" /></mxCell><mxCell id="m_decide" value="&lt;b&gt;Policy decision&lt;/b&gt;&lt;br&gt;local-only · mask external&lt;br&gt;human approval · block" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e8f7f0;strokeColor=#127a51;fontColor=#1d2733;fontSize=12;spacing=5;" vertex="1" parent="1"><mxGeometry x="670" y="340" width="260" height="95" as="geometry" /></mxCell><mxCell id="m_token" value="&lt;b&gt;Reversible tokenization&lt;/b&gt;&lt;br&gt;deterministic per tenant/session&lt;br&gt;mapping TTL + purpose + access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="250" height="95" as="geometry" /></mxCell><mxCell id="m_redact" value="&lt;b&gt;Irreversible transform&lt;/b&gt;&lt;br&gt;redact · generalize · suppress&lt;br&gt;no mapping retained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="170" height="95" as="geometry" /></mxCell><mxCell id="m_vault" value="&lt;b&gt;Encrypted mapping vault&lt;/b&gt;&lt;br&gt;HSM/KMS-wrapped keys&lt;br&gt;tenant-isolated · short TTL" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d9f3e8;strokeColor=#127a51;fontColor=#1d2733;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="250" height="75" as="geometry" /></mxCell><mxCell id="m_local" value="&lt;b&gt;Domestic model&lt;/b&gt;&lt;br&gt;no external egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="205" width="170" height="75" as="geometry" /></mxCell><mxCell id="m_external" value="&lt;b&gt;Approved external model&lt;/b&gt;&lt;br&gt;masked payload only&lt;br&gt;provider contract + allowlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e5;strokeColor=#c9992e;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1360" y="205" width="190" height="90" as="geometry" /></mxCell><mxCell id="m_response" value="&lt;b&gt;Normalized response&lt;/b&gt;&lt;br&gt;JSON / SSE / usage metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2f5fb0;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="220" height="75" as="geometry" /></mxCell><mxCell id="m_validate" value="&lt;b&gt;Output validation&lt;/b&gt;&lt;br&gt;schema · content · PII · secrets&lt;br&gt;tool/action authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1090" y="520" width="300" height="90" as="geometry" /></mxCell><mxCell id="m_restore" value="&lt;b&gt;Restore policy&lt;/b&gt;&lt;br&gt;only authorized tenant/session&lt;br&gt;otherwise keep de-identified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f9d6b;strokeColor=#127a51;fontColor=#ffffff;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="865" width="300" height="70" as="geometry" /></mxCell><mxCell id="m_audit" value="&lt;b&gt;Audit evidence&lt;/b&gt;&lt;br&gt;redacted fingerprints · policy version · decision reason · access log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eaff;strokeColor=#7a4fa3;fontColor=#1d2733;fontStyle=1;fontSize=12;spacing=6;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="865" width="470" height="70" as="geometry" /></mxCell><mxCell id="me1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_request" target="m_parse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_parse" target="m_detect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_detect" target="m_entities"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_entities" target="m_classify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_classify" target="m_decide"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me6" value="reversible" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_decide" target="m_token"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="me7" value="irreversible" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m_decide" target="m_redact"><mxGeometry relative="1" as="geometry" /></m