# Safe default: deterministic fake provider, so tests do not need Ollama.
PROVIDER_MODE=fake

# For local inference after installing Ollama and pulling a model:
# PROVIDER_MODE=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=120

# Optional Presidio NER/context-aware detection. The MVP regex recognizers work without it.
USE_PRESIDIO=false
