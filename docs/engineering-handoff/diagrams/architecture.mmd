flowchart TB
    Client[Client SDK / Browser / Application] --> Edge[DNS + TLS + Ingress]
    Edge --> Gateway[Unified API Gateway]
    Gateway --> Auth[Auth and RBAC]
    Gateway --> Router[Routing Engine]
    Router --> Privacy[Data Masking and Privacy]
    Router --> Provider[Provider Adapter Layer]
    Provider --> P1[Alibaba Model Studio]
    Provider --> P2[Provider B]
    Provider --> P3[Provider C]
    Gateway --> Control[Control Plane APIs]
    Control --> UserPanel[User Panel]
    Control --> AdminPanel[Admin Panel]
    Control --> Catalog[Provider and Model Catalog]
    Control --> Policy[Route / Privacy / Budget Policies]
    Gateway --> Cache[(Redis / Valkey)]
    Auth --> AuthDB[(Auth PostgreSQL)]
    Control --> BillingDB[(Billing PostgreSQL)]
    Services[Services] --> Outbox[Transactional Outbox]
    Outbox --> Events[Event Bus]
    Events --> Data[Data Platform]
    Data --> Analytics[Analytics and Exports]
    Store[Agent / App Store] --> Runtime[Isolated Agent Runtime]
    Runtime --> Broker[Tool Permission Broker]
    Broker --> Tools[Approved Tools and Connectors]
    AdminPanel --> Observability[Prometheus + Grafana + Loki + OTel]
    Gateway --> Observability
    Router --> Observability
    Provider --> Observability
