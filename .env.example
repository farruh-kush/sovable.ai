# ─────────────────────────────────────────────────────────────────────────────
# AI Routing Layer — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Author: Farruh
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["https://dashboard.yourdomain.com"]
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change these in production
ADMIN_API_KEY=change-me-in-production
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ── Billing ───────────────────────────────────────────────────────────────────
# Platform markup percentage (e.g. 0.055 = 5.5% markup on provider costs)
PLATFORM_MARKUP=0.055

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Leave blank to use mock responses (for local development without API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
